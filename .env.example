# ── Base de datos ────────────────────────────────────────────────────────────
# El backend solo soporta PostgreSQL (app/core/database.py lo valida al arrancar).
# En local con docker-compose.yml: puerto 5433. En el compose de despliegue: host `db`, puerto 5432.
DATABASE_URL=postgresql+psycopg2://fashionstore:fashionstore@localhost:5433/fashionstore

# Credenciales de Postgres que usa docker-compose.deploy.yml
POSTGRES_USER=fashionstore
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=fashionstore

# development | production  (en production el esquema lo crea Alembic, no create_all)
ENVIRONMENT=development

# ── Seguridad ────────────────────────────────────────────────────────────────
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ─────────────────────────────────────────────────────────────────────
# Lista JSON con los orígenes del front. En producción agrega el dominio real del
# sitio (p. ej. https://fashionstore-web.onrender.com). Los orígenes locales
# (http://localhost:4200, http://127.0.0.1:4200) se incluyen siempre automáticamente.
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# ── Pagos (CU11 web / CU12 caja) ─────────────────────────────────────────────
# La caja (RF18: efectivo, tarjeta, datáfono) NO usa pasarela: se envía
# payment_provider=efectivo|tarjeta|datafono y el comercio confirma el cobro con el comprobante POS.
# Para el checkout web (RF19) pega una clave de PRUEBAS de Stripe: sin clave, el checkout devuelve
# un error explícito (503). PAYMENT_PROVIDER=not_configured también es válido para una demo sin cobro.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com/v1

# ── Facturación (módulo Ventas, Facturación y Caja) ─────────────────────────
# simulated      → documento con IVA y número de factura generados por el sistema (sin validez fiscal).
# not_configured → POST /commerce/sales/{id}/invoice responde 503 a propósito.
# El precio de la venta se interpreta con IVA incluido; el % y los datos del emisor son configurables.
FISCAL_PROVIDER=simulated
FISCAL_TAX_RATE=0.19
FISCAL_ISSUER_NAME=FashionStore S.A.S.
FISCAL_ISSUER_TAX_ID=

# ── Integraciones opcionales ─────────────────────────────────────────────────
NOTIFICATION_PROVIDER=not_configured

# ── IA (CU18 / CU19 / CU24) ──────────────────────────────────────────────────
# disabled | gemini. Con `disabled` el sistema responde con reglas deterministas.
AI_PROVIDER_MODE=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Voz (CU24) ───────────────────────────────────────────────────────────────
SPEECH_PROVIDER_MODE=disabled
GOOGLE_SPEECH_API_KEY=
GOOGLE_SPEECH_LANGUAGE_CODE=es-CO
